# Database URL
DATABASE_URL="file:./dev.db" # or postgresql://user:password@localhost:5432/campaignops?schema=public

# Application URLs
APP_URL="http://localhost:3000"
API_URL="http://localhost:3000/api"

# Auth Secrets
AUTH_SECRET="change-this-to-a-secure-random-string"

# Storage Configuration
STORAGE_PROVIDER="local" # local, s3, gcs
STORAGE_BUCKET="campaign-assets"

# AI & OCR Configuration (Mock provider by default)
AI_PROVIDER="mock" # mock, gemini, openai
AI_API_KEY=""
OCR_PROVIDER="mock" # mock, tesseract, cloud-vision
OCR_API_KEY=""
